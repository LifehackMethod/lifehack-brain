#!/bin/sh
# REFUSE any commit that would put the person's own notes into this repository.
#
# WHY THIS IS CODE AND NOT A LINE IN THE README: pushing personal material to a PUBLIC repository is
# IRREVERSIBLE -- it is cached and indexed even if deleted afterwards -- and the mistake happens at the
# exact moment nobody is thinking about it (a hurried `git add -A`). A rule you have to remember is not a
# control. This fires whether or not anyone remembers it.
#
# WHO IT ACTUALLY PROTECTS -- stated honestly, because the general framing overstates it: an ordinary
# student CANNOT reach this repository at all; they clone a public repo and hold no write credentials, so
# for them the leak path does not exist. This guard exists for the handful of COLLABORATORS who do have
# push access and are running the tool on their own real material.
#
# WHAT IT DOES NOT DO: it does not stop someone who deliberately passes --no-verify, and it protects
# nobody who never ran `git config core.hooksPath system/githooks`. It is a guard, not a sandbox. The
# sandbox is keeping `memory/` outside the repository altogether.

staged=$(git diff --cached --name-only --diff-filter=ACMR)

# data/ is theirs, and since the 2026-08-12 layout change it sits INSIDE this repository -- one
# .gitignore line is all that keeps it out of git, where folder distance used to do the job. memory/ is
# the pre-2026-08-12 name for the same thing and is kept here so an older install is still covered.
# state/ is the ingest's working notes about their material -- half-sorted piles, extracted conclusions,
# a map of what is in their export -- which is just as personal as the material itself. The rest are
# raw-corpus fingerprints: an export unpacked into the repo by hand is the measured failure (2026-08-09,
# 6,228 files staged, including a users.json holding an email address and a phone number). .gitignore
# does not catch a file that is force-added or was tracked before it was ignored, which is exactly why
# this check exists as well.
#
# ⛔ WHY data/ IS NAMED FIRST, AND THE MEASURED REASON THIS LINE EXISTS (2026-08-13, S5.2 smoke test).
# This pattern said `memory/` and nothing else for the whole of the one-folder layout's life. .gitignore
# was updated on 2026-08-12 and even carries the warning "do not let anything add data/ with git add -f"
# -- but the guard that is the ONLY thing able to stop a force-add was not updated with it, so the two
# halves of one change disagreed for a day. A fresh-clone test force-added data/canon.md and the commit
# was ACCEPTED. INSTALL.md STEP 6 promises the student in plain words that this catch "will stop and
# refuse"; for the folder their notes actually live in, it did not. The stale comment that used to sit
# here -- "it lives outside the repo by design" -- was true before the layout changed and is why nobody
# looked. A path-shaped guard has to be re-read every time the paths move.
#
# state/ deliberately has NO .gitignore entry to match. A folder that is never created inside the repo
# needs no rule, and an ignore line would quietly teach the opposite -- that state/ belongs here and is
# merely hidden. Absence is the real control; this is the cheap second one.
offenders=$(printf '%s\n' "$staged" \
	| grep -E '^data/|^memory/|(^|/)state/|(^|/)_unpacked/|\.zip$|(^|/)conversations\.json$|(^|/)users\.json$|(^|/)\.brain-root$' \
	| grep -v -x 'memory/README.md')

if [ -n "$offenders" ]; then
	echo ""
	echo "  ⛔ COMMIT REFUSED — this would put personal notes into a public repository."
	echo ""
	echo "  These staged files are YOUR material -- data/ is what you write, state/ is what the ingest"
	echo "  worked out about it -- and neither may be committed:"
	printf '%s\n' "$offenders" | sed 's/^/      /'
	echo ""
	echo "  Unstage them and commit again:"
	echo ""
	printf '%s\n' "$offenders" | sed 's|^|      git restore --staged "|; s|$|"|'
	echo ""
	echo "  (Nothing under data/ may be committed; on an older install, only memory/README.md may. If you"
	echo "   genuinely need to override this, you know how"
	echo "   — but read the line above twice first: a push to a public repo cannot be taken back.)"
	echo ""
	exit 1
fi

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# SECRET SCANNING (gitleaks) — MERGED IN 2026-08-22, T10.D1.
#
# WHY THIS EXISTS HERE NOW: the pre-migration clone's `system/githooks/pre-commit` ran gitleaks;
# this file, at the same path in the new repo, did not — the migration replaced one hook with the
# other instead of merging them, so `~/ClaudeOps` briefly had a personal-notes guard and NO secret
# scanning at all. Ruled 2026-08-22 (`authority: user`, closes Q21/G14 part 2): merge both
# behaviours, keep FAIL-CLOSED, and pay the cost by shipping gitleaks in the installer (INSTALL.md,
# T10.D4) rather than by weakening the guard.
#
# ⛔ FAIL CLOSED, ON PURPOSE. A scanner that passes a commit because it could not check is theatre.
# If gitleaks is not on PATH (or at the Homebrew default), THE COMMIT IS REFUSED — not silently
# allowed through. Install: brew install gitleaks (see INSTALL.md). Genuine false positive on an
# installed run: git commit --no-verify.
GITLEAKS="$(command -v gitleaks || echo /opt/homebrew/bin/gitleaks)"

if [ ! -x "$GITLEAKS" ]; then
	echo ""
	echo "  ⛔ COMMIT REFUSED — gitleaks (secret scanner) not found. This hook FAILS CLOSED: it will"
	echo "  not let a commit through with secret-scanning silently skipped."
	echo ""
	echo "  Install:  brew install gitleaks   (see INSTALL.md)"
	echo "  Bypass only if you are certain there is nothing to catch: git commit --no-verify"
	echo ""
	exit 1
fi

if ! "$GITLEAKS" git --staged --redact --no-banner; then
	echo ""
	echo "  ⛔ COMMIT REFUSED — gitleaks detected a possible secret in staged changes." >&2
	echo "  Remove the secret (move it to a secrets manager or the keychain)." >&2
	echo "  False positive? git commit --no-verify" >&2
	echo ""
	exit 1
fi

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# INTERNAL-LEAKAGE / OPERATOR-IDENTITY SCAN (check_no_internal_leakage.py) — WIRED IN 2026-08-22,
# T10.D1. Until now this scanner only ran server-side in CI (.github/workflows/no-internal-leakage.yml),
# diffing base...head on an already-PUSHED commit — too late to stop the push itself. This runs the
# identical rule engine locally, pre-commit, against what is actually STAGED (the index), so the same
# class of leak that shipped migration-audit/08-THIRD-PARTY-INVENTORY.md (see that script's own
# docstring) is caught before it ever leaves the machine.
#
# WHY PER-FILE --scan-file AND NOT --base/--head: there is no committed "before" to diff against yet
# — the content only exists in the index. --scan-file treats the whole staged content of one file as
# if every line were added, which is a superset of what a diff-based scan would catch, never a subset.
#
# ⛔ FAIL CLOSED — identical contract to the CI run. check_no_internal_leakage.py's own rule 3
# (operator identity) refuses to compile without a usable out-of-repo identity source
# (<notes>/config/ship-identity.md via $SHIP_IDENTITY or --identity) and exits 2 (CANNOT EVALUATE)
# rather than scanning with that tier silently empty. This hook treats BOTH a real finding (exit 1)
# and CANNOT EVALUATE (exit 2) as REFUSE — a scanner that could not check is not a scanner that passed.
# Same applies if python3 itself is missing, or the script file is gone: refuse, don't skip.
repo=$(git rev-parse --show-toplevel)
leak_scanner="$repo/.github/scripts/check_no_internal_leakage.py"

if ! command -v python3 >/dev/null 2>&1; then
	echo ""
	echo "  ⛔ COMMIT REFUSED — no python3 on PATH, so the internal-leakage/identity scan could not"
	echo "  run. This hook FAILS CLOSED rather than committing unchecked."
	echo ""
	exit 1
fi

if [ ! -f "$leak_scanner" ]; then
	echo ""
	echo "  ⛔ COMMIT REFUSED — $leak_scanner is missing. The internal-leakage scanner cannot run,"
	echo "  and this hook FAILS CLOSED rather than committing unchecked."
	echo ""
	exit 1
fi

leak_tmp=$(mktemp -d 2>/dev/null) || leak_tmp=""
if [ -z "$leak_tmp" ]; then
	echo ""
	echo "  ⛔ COMMIT REFUSED — could not create a scratch dir for the internal-leakage scan. FAILS"
	echo "  CLOSED rather than committing unchecked."
	echo ""
	exit 1
fi

leak_failed=0
leak_out=""
old_ifs=$IFS
IFS='
'
set -f
for f in $staged; do
	# Binary staged content can't be scanned as text and isn't what this tier looks for
	# (gitleaks above already covers binaries for secrets); skip it explicitly rather than
	# letting the scanner choke on undecodable bytes and refuse for the wrong reason.
	added_field=$(git diff --cached --numstat -- "$f" | awk '{print $1; exit}')
	[ "$added_field" = "-" ] && continue

	staged_copy="$leak_tmp/$(basename "$f").staged"
	if ! git show ":$f" >"$staged_copy" 2>/dev/null; then
		continue
	fi

	one_out=$(python3 "$leak_scanner" --scan-file "$staged_copy" --as-path "$f" 2>&1)
	one_status=$?
	if [ "$one_status" -ne 0 ]; then
		leak_failed=1
		leak_out="$leak_out
$one_out"
	fi
done
set +f
IFS=$old_ifs
rm -rf "$leak_tmp"

if [ "$leak_failed" -ne 0 ]; then
	echo ""
	echo "  ⛔ COMMIT REFUSED — check_no_internal_leakage.py flagged staged content (or could not" >&2
	echo "  evaluate it — CANNOT EVALUATE is treated as a refusal here, never a pass)." >&2
	printf '%s\n' "$leak_out" >&2
	echo "" >&2
	echo "  False positive? git commit --no-verify" >&2
	echo "" >&2
	exit 1
fi

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# Every file, skill and hook these documents NAME must be here, or its line must say what happened
# to it. See system/tools/citation_lint.py for the rule and the three markers.
#
# WHY ON EVERY COMMIT AND NOT ONLY WHEN A .md CHANGES: this breaks most often from the other side.
# Nobody edits a document to make its citation dangle -- they move or rename the file it points at,
# and the document that goes stale is one they never opened.
#
# WHY SCOPED TO $staged (computed at the top of this file) AND NOT THE WHOLE TREE. Before this, a
# stale citation ANYWHERE in the repository blocked EVERY commit, including one that touched
# neither the stale document nor anything it names -- a fresh clone with a single pre-existing
# citation could not commit at all (issues #81, #90, #74.3). $staged is already the set this commit
# is actually about; scoping to it makes the gate block what this commit broke, not what someone
# else left broken. `citation_lint.py --files` still runs the HOOKS check (settings.json <->
# system/hooks/) when the staged set touches either side of it, so a commit that really does
# register a hook wrong is still caught -- and a bare `python3 citation_lint.py`, with no --files at
# all, still walks the whole tree: that is what the line below tells you to run by hand.
# ⚠ CORRECTED 2026-09-01: the line used to also claim "that is what CI runs" here -- FALSE, struck,
# never silently overwritten. As of this date no CI workflow calls citation_lint.py at all (verified:
# `grep -rn citation_lint .github/workflows/` finds nothing); the whole-tree sweep is not wired to
# anything automated yet. See A3/A4 task notes for the fix in flight. Scoping what BLOCKS A COMMIT is
# not the same as checking less overall.
#
# WHY IT FAILS OPEN WITHOUT python3 AND THE CHECK ABOVE DOES NOT: that one protects a person's
# private notes from an irreversible push, so it must never be skippable. This one protects the
# documentation's accuracy, and blocking a commit because an interpreter is missing would cost more
# than the drift it caught. It says so rather than passing quietly.
repo=$(git rev-parse --show-toplevel)
if command -v python3 >/dev/null 2>&1; then
	# $staged is newline-separated (one path per line, from --name-only above); split on newline
	# ONLY (not space) and turn glob expansion off, so a staged filename holding a space or a `*`
	# becomes one correct argument instead of several wrong ones.
	old_ifs=$IFS
	IFS='
'
	set -f
	set -- $staged
	set +f
	IFS=$old_ifs

	if ! python3 "$repo/system/tools/citation_lint.py" --quiet --files "$@"; then
		echo "  Commit refused. Fix the lines above, or run the lint yourself to see them again:"
		echo ""
		echo "      python3 system/tools/citation_lint.py --files $staged"
		echo ""
		echo "  (That checks only what you staged. For the whole tree, drop --files entirely."
		echo "   ⚠ CORRECTED 2026-09-01: this used to also say 'that is also what CI runs' -- FALSE."
		echo "   No CI workflow calls citation_lint.py as of this date; running the whole-tree sweep"
		echo "   is still a by-hand or scheduled step, not something CI does for you.)"
		echo ""
		exit 1
	fi
else
	echo "  ⚠ citation lint SKIPPED — no python3 on PATH. Documentation citations were NOT checked."
fi

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# ENCODING LINT (encoding_lint.py) — WIRED 2026-08-23, T5.7c. Refuses a commit that RAISES a file's
# count of unencoded open() calls — no `encoding=` keyword, or `encoding=None` spelled out. See
# system/tools/encoding_lint.py's own docstring for the AST rule and why it exists as a fourth tool
# rather than folded into citation_lint (text-based, no `import ast`), order_lint (ordering, not
# encoding) or topic-vocab-lint (vocabulary).
#
# ⛔ A RATCHET, NEVER WHOLE-FILE, ON PURPOSE. This repo carries 369 pre-existing unencoded open()
# calls across the tree (measured 2026-08-23) -- a whole-file gate would refuse every file holding
# one on its next unrelated touch, which is exactly the scrub.py scar fixed the same day in commit
# d8d4c94 via check_no_internal_leakage.py's --scan-file mode. `--staged` is the ONLY mode this hook
# may pass encoding_lint.py; --scan-file (whole-file) must never appear here.
#
# ⭐ WHY A RATCHET AND NOT "lines this diff ADDS", which is what this stage shipped with for an hour:
# a defect can be created by DELETING a line. Drop just the `encoding="utf-8"` line out of a
# multi-line open( ... ) and keep the trailing comma, and the only hunk is a deletion -- ZERO added
# lines, nothing for an added-line model to intersect against, brand-new defect invisible by
# construction. Widening from the call's own lineno to its whole span does not help. So the gate
# compares the file's defect count in the staged image against HEAD's and refuses only a RISE.
# Grandfathering then holds BY CONSTRUCTION rather than by a line-intersection somebody has to keep
# honest. ⚠ The accepted hole, stated rather than chased with a third mechanism: adding one defect
# while removing another in the same file nets zero and passes.
#
# EXIT 1 (a real new defect) REFUSES the commit -- same as the leak scanner above. EXIT 2
# (CANNOT EVALUATE) covers THREE distinct causes -- see encoding_lint.py's own --help:
# no-python-staged (ordinary: nothing in this commit for the linter to look at), and
# unparseable <path> / no-git (NOT ordinary: the check itself did not complete). Only
# no-python-staged gets the same fail-open the citation-lint stage above gets, and for the
# same reason: it is the ORDINARY case for a markdown-only or config-only commit, and
# treating it as a refusal would brick every such commit -- the exact failure class this
# whole plan exists to fix. unparseable/no-git are NOT that -- they mean the check itself
# did not complete, same category as a missing script (below), not an empty input.
#
# ⚠ RESTORED 2026-09-16 (fix/red-tests) -- this exit-2 split, and the missing-script check
# below, shipped in commits e38f99e and 0ee941e (2026-08-24) and were silently dropped by
# d13c5e4's "Phase H" doc re-derivation (2026-09-01), which rewrote this section's comments
# and, with them, overwrote the two functional fixes back to their pre-fix shape -- the commit
# message never mentions removing either, so this reads as re-derivation clobbering code, not a
# deliberate call. test_encoding_lint.py::HookWiring caught the drop (expected 6 non-comment
# lines naming encoding_lint.py, found 3); that failure is what surfaced this. Do not re-fold
# this split into one branch, and do not drop the missing-script check again.
#
# A FOURTH STATE, DISTINCT FROM ALL THREE ABOVE: THE SCRIPT ITSELF IS MISSING (found
# 2026-08-24). "no python3 on PATH" and "no .py staged" are both ordinary, environment- or
# commit-shaped absences -- the CONTROL is present and simply has nothing to check, or
# nothing to check it with. A missing encoding_lint.py is not that: the control itself has
# been removed from this checkout, and python3 would happily exit 2 ("[Errno 2] No such
# file or directory") -- indistinguishable, to a hook that isn't checking for it, from
# "nothing to check." Measured: a fresh clone of origin/main with this hook wired ran
# `python3 <missing path> --staged --quiet`, got exit 2, and committed a bare unencoded
# open() clean. That is fail-open on the CONTROL DISAPPEARING, not on its input being empty,
# so it does not get the pass an absent python3 or an absent .py file gets: it REFUSES,
# checked BEFORE the script ever runs.
if command -v python3 >/dev/null 2>&1; then
	if [ ! -f "$repo/system/tools/encoding_lint.py" ]; then
		echo ""
		echo "  ⛔ COMMIT REFUSED — encoding lint tool MISSING: system/tools/encoding_lint.py is not"
		echo "  present in this checkout. This is not 'nothing to check' -- the security control"
		echo "  itself is absent. Restore it (git checkout origin/main -- system/tools/encoding_lint.py)"
		echo "  or pull latest."
		echo ""
		exit 1
	fi
	encoding_out=$(python3 "$repo/system/tools/encoding_lint.py" --staged --quiet 2>&1)
	encoding_status=$?
	if [ "$encoding_status" -eq 1 ]; then
		echo ""
		echo "  ⛔ COMMIT REFUSED — encoding_lint.py found a new unencoded open() call."
		printf '%s\n' "$encoding_out"
		echo "  Fix the line(s) above, or run the lint yourself:"
		echo ""
		echo "      python3 system/tools/encoding_lint.py --staged"
		echo ""
		exit 1
	elif [ "$encoding_status" -eq 2 ]; then
		if printf '%s\n' "$encoding_out" | head -1 | grep -q 'CANNOT-EVALUATE: no-python-staged'; then
			echo "  ⚠ encoding lint: $(printf '%s\n' "$encoding_out" | head -1)"
		else
			echo ""
			echo "  ⛔ COMMIT REFUSED — encoding lint could not evaluate your staged changes (see below)."
			printf '%s\n' "$encoding_out"
			echo "  This is not 'nothing to check' -- the check itself did not complete. Fix the"
			echo "  underlying problem (an unparseable staged file, or git) and commit again."
			echo ""
			exit 1
		fi
	fi
else
	echo "  ⚠ encoding lint SKIPPED — no python3 on PATH. New open() calls were NOT checked."
fi

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# WIRING-DRIFT CHECK (check_drift.py) — WIRED 2026-09-15, enforcement-layer Phase 2 Feature B3.2.
# D5 (Enver, 2026-09-15): the register's runner is ON-COMMIT — every commit regenerates the
# wiring from the register and runs the FAST checks here, REFUSING the commit on drift. The one
# slow check (the caller lint, ~8.2 s of `generate.py`'s ~99% of its own runtime — see the plan's
# "Runner cost, measured for D5") runs in GitHub CI instead (`--no-caller-lint` here) — a human
# waiting on `git commit` should not pay a cost a server-side job can absorb for them.
#
# WHY THIS MECHANISM AND NOT A NEW CLAUDE SESSION HOOK: this repository already runs its
# commit-time checks (the personal-notes guard, gitleaks, check_no_internal_leakage.py, the
# citation lint, the encoding lint, all above) as stages inside THIS FILE — a versioned git hook
# activated by `git config core.hooksPath system/githooks` (see the repo-wide setup this file's
# own stages already assume). check_drift.py is one more stage in the same mechanism, on
# purpose: it fires only at the one moment that matters (a real commit), needs no Claude session
# to be running, and adds ZERO entries to `.claude/settings.json` / `hooks/hooks.json` — the
# whole point of putting the runner here rather than teaching a new Claude PreToolUse hook to
# watch for `git commit`.
#
# ⛔ FAIL CLOSED — same posture as gitleaks and check_no_internal_leakage.py above, and for the
# same reason: a stale `.claude/settings.json` / `hooks/hooks.json` is a silent guard-disablement
# risk (a hook that quietly stops firing because the wiring file drifted out from under it), not
# a cosmetic lint. If python3 is missing, or check_drift.py itself is gone, the commit is
# REFUSED — not silently allowed through unchecked.
#
# check_drift.py calls `generate.py` by its CLI only, against the COMMITTED register
# (`system/register/register.jsonl` — the fixed point; see check_drift.py's own module
# docstring for why an earlier version that re-harvested the staged tree itself was circular
# and missed real drift) inside a throwaway copy of the STAGED tree (never the real working
# tree), cleaning up after itself either way. Default severity is WARN (Enver's B1.4 ruling,
# 2026-09-15): an omission-check finding is reported, never a refusal, unless generate.py is
# explicitly run at `--severity refuse`, which this stage does not do.
repo=$(git rev-parse --show-toplevel)
if ! command -v python3 >/dev/null 2>&1; then
	echo ""
	echo "  ⛔ COMMIT REFUSED — no python3 on PATH, so the wiring-drift check could not run."
	echo "  This hook FAILS CLOSED rather than committing unchecked wiring."
	echo ""
	exit 1
fi

drift_checker="$repo/system/register/check_drift.py"
if [ ! -f "$drift_checker" ]; then
	echo ""
	echo "  ⛔ COMMIT REFUSED — $drift_checker is missing. The wiring-drift check cannot run,"
	echo "  and this hook FAILS CLOSED rather than committing unchecked wiring."
	echo ""
	exit 1
fi

if ! python3 "$drift_checker"; then
	exit 1
fi

exit 0
