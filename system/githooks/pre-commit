#!/bin/sh
# REFUSE any commit that would put the person's own notes into this repository.
#
# WHY THIS IS CODE AND NOT A LINE IN THE README: pushing personal material to a PUBLIC repository is
# IRREVERSIBLE -- it is cached and indexed even if deleted afterwards -- and the mistake happens at the
# exact moment nobody is thinking about it (a hurried `git add -A`). A rule you have to remember is not a
# control. This fires whether or not anyone remembers it.
#
# WHO IT ACTUALLY PROTECTS -- stated honestly, because the general framing overstates it: an ordinary
# student CANNOT reach this repository at all; they clone a public repo and hold no write credentials, so
# for them the leak path does not exist. This guard exists for the handful of COLLABORATORS who do have
# push access and are running the tool on their own real material.
#
# WHAT IT DOES NOT DO: it does not stop someone who deliberately passes --no-verify, and it protects
# nobody who never ran `git config core.hooksPath system/githooks`. It is a guard, not a sandbox. The
# sandbox is keeping `memory/` outside the repository altogether.

staged=$(git diff --cached --name-only --diff-filter=ACMR)

# data/ is theirs, and since the 2026-08-12 layout change it sits INSIDE this repository -- one
# .gitignore line is all that keeps it out of git, where folder distance used to do the job. memory/ is
# the pre-2026-08-12 name for the same thing and is kept here so an older install is still covered.
# state/ is the ingest's working notes about their material -- half-sorted piles, extracted conclusions,
# a map of what is in their export -- which is just as personal as the material itself. The rest are
# raw-corpus fingerprints: an export unpacked into the repo by hand is the measured failure (2026-08-09,
# 6,228 files staged, including a users.json holding an email address and a phone number). .gitignore
# does not catch a file that is force-added or was tracked before it was ignored, which is exactly why
# this check exists as well.
#
# ⛔ WHY data/ IS NAMED FIRST, AND THE MEASURED REASON THIS LINE EXISTS (2026-08-13, S5.2 smoke test).
# This pattern said `memory/` and nothing else for the whole of the one-folder layout's life. .gitignore
# was updated on 2026-08-12 and even carries the warning "do not let anything add data/ with git add -f"
# -- but the guard that is the ONLY thing able to stop a force-add was not updated with it, so the two
# halves of one change disagreed for a day. A fresh-clone test force-added data/canon.md and the commit
# was ACCEPTED. INSTALL.md STEP 6 promises the student in plain words that this catch "will stop and
# refuse"; for the folder their notes actually live in, it did not. The stale comment that used to sit
# here -- "it lives outside the repo by design" -- was true before the layout changed and is why nobody
# looked. A path-shaped guard has to be re-read every time the paths move.
#
# state/ deliberately has NO .gitignore entry to match. A folder that is never created inside the repo
# needs no rule, and an ignore line would quietly teach the opposite -- that state/ belongs here and is
# merely hidden. Absence is the real control; this is the cheap second one.
offenders=$(printf '%s\n' "$staged" \
	| grep -E '^data/|^memory/|(^|/)state/|(^|/)_unpacked/|\.zip$|(^|/)conversations\.json$|(^|/)users\.json$|(^|/)\.brain-root$' \
	| grep -v -x 'memory/README.md')

if [ -n "$offenders" ]; then
	echo ""
	echo "  ⛔ COMMIT REFUSED — this would put personal notes into a public repository."
	echo ""
	echo "  These staged files are YOUR material -- data/ is what you write, state/ is what the ingest"
	echo "  worked out about it -- and neither may be committed:"
	printf '%s\n' "$offenders" | sed 's/^/      /'
	echo ""
	echo "  Unstage them and commit again:"
	echo ""
	printf '%s\n' "$offenders" | sed 's|^|      git restore --staged "|; s|$|"|'
	echo ""
	echo "  (Nothing under data/ may be committed; on an older install, only memory/README.md may. If you"
	echo "   genuinely need to override this, you know how"
	echo "   — but read the line above twice first: a push to a public repo cannot be taken back.)"
	echo ""
	exit 1
fi

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# SECRET SCANNING (gitleaks) — MERGED IN 2026-08-22, T10.D1.
#
# WHY THIS EXISTS HERE NOW: the pre-migration clone's `system/githooks/pre-commit` ran gitleaks;
# this file, at the same path in the new repo, did not — the migration replaced one hook with the
# other instead of merging them, so `~/ClaudeOps` briefly had a personal-notes guard and NO secret
# scanning at all. Ruled 2026-08-22 (`authority: user`, closes Q21/G14 part 2): merge both
# behaviours, keep FAIL-CLOSED, and pay the cost by shipping gitleaks in the installer (INSTALL.md,
# T10.D4) rather than by weakening the guard.
#
# ⛔ FAIL CLOSED, ON PURPOSE. A scanner that passes a commit because it could not check is theatre.
# If gitleaks is not on PATH (or at the Homebrew default), THE COMMIT IS REFUSED — not silently
# allowed through. Install: brew install gitleaks (see INSTALL.md). Genuine false positive on an
# installed run: git commit --no-verify.
GITLEAKS="$(command -v gitleaks || echo /opt/homebrew/bin/gitleaks)"

if [ ! -x "$GITLEAKS" ]; then
	echo ""
	echo "  ⛔ COMMIT REFUSED — gitleaks (secret scanner) not found. This hook FAILS CLOSED: it will"
	echo "  not let a commit through with secret-scanning silently skipped."
	echo ""
	echo "  Install:  brew install gitleaks   (see INSTALL.md)"
	echo "  Bypass only if you are certain there is nothing to catch: git commit --no-verify"
	echo ""
	exit 1
fi

if ! "$GITLEAKS" git --staged --redact --no-banner; then
	echo ""
	echo "  ⛔ COMMIT REFUSED — gitleaks detected a possible secret in staged changes." >&2
	echo "  Remove the secret (move it to a secrets manager or the keychain)." >&2
	echo "  False positive? git commit --no-verify" >&2
	echo ""
	exit 1
fi

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# REFUSE any commit that would track a symlink. WHY: .claude/ as it ships today holds ZERO
# symlinks -- every skill is a real directory -- and INSTALL.md states the rule in plain words: "Do
# NOT symlink anything into ~/.claude/. Symlinks are Mac-coupled and this has to work on Windows
# too." Git tracks a symlink as its own mode (120000) no matter how it looks in the working tree, so
# one can be staged by accident and would then ship to every student who clones this repo -- and on
# Windows, a checked-out symlink can silently become a plain text file holding a path, which fails
# confusingly rather than loudly.
#
# `git ls-files -s` reads the INDEX, not the working tree, so this catches a symlink the moment it
# is staged -- before `ls` would even show it as one. That is also why this is cheap: it is one
# index read, never a tree walk.
symlinks=$(git ls-files -s | grep '^120000 ' | cut -f2-)

if [ -n "$symlinks" ]; then
	echo ""
	echo "  ⛔ COMMIT REFUSED — this would make the repo track a symlink."
	echo ""
	echo "  These paths are symlinks (git mode 120000), and none may be committed:"
	printf '%s\n' "$symlinks" | sed 's/^/      /'
	echo ""
	echo "  WHY: symlinks are Mac-coupled and this repo has to work on Windows too (INSTALL.md). A"
	echo "  checked-out symlink can silently become a plain text file holding a path on Windows --"
	echo "  a confusing, silent failure for every student who clones this repo."
	echo ""
	echo "  Commit a real file or a real directory instead of the symlink above."
	echo ""
	exit 1
fi

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# Every file, skill and hook these documents NAME must be here, or its line must say what happened
# to it. See system/tools/citation_lint.py for the rule and the three markers.
#
# WHY ON EVERY COMMIT AND NOT ONLY WHEN A .md CHANGES: this breaks most often from the other side.
# Nobody edits a document to make its citation dangle -- they move or rename the file it points at,
# and the document that goes stale is one they never opened.
#
# WHY SCOPED TO $staged (computed at the top of this file) AND NOT THE WHOLE TREE. Before this, a
# stale citation ANYWHERE in the repository blocked EVERY commit, including one that touched
# neither the stale document nor anything it names -- a fresh clone with a single pre-existing
# citation could not commit at all (issues #81, #90, #74.3). $staged is already the set this commit
# is actually about; scoping to it makes the gate block what this commit broke, not what someone
# else left broken. `citation_lint.py --files` still runs the HOOKS check (settings.json <->
# system/hooks/) when the staged set touches either side of it, so a commit that really does
# register a hook wrong is still caught -- and a bare `python3 citation_lint.py`, with no --files at
# all, still walks the whole tree: that is what CI runs, and what the line below tells you to run by
# hand. Scoping what BLOCKS A COMMIT is not the same as checking less overall.
#
# WHY IT FAILS OPEN WITHOUT python3 AND THE CHECK ABOVE DOES NOT: that one protects a person's
# private notes from an irreversible push, so it must never be skippable. This one protects the
# documentation's accuracy, and blocking a commit because an interpreter is missing would cost more
# than the drift it caught. It says so rather than passing quietly.
repo=$(git rev-parse --show-toplevel)
if command -v python3 >/dev/null 2>&1; then
	# $staged is newline-separated (one path per line, from --name-only above); split on newline
	# ONLY (not space) and turn glob expansion off, so a staged filename holding a space or a `*`
	# becomes one correct argument instead of several wrong ones.
	old_ifs=$IFS
	IFS='
'
	set -f
	set -- $staged
	set +f
	IFS=$old_ifs

	if ! python3 "$repo/system/tools/citation_lint.py" --quiet --files "$@"; then
		echo "  Commit refused. Fix the lines above, or run the lint yourself to see them again:"
		echo ""
		echo "      python3 system/tools/citation_lint.py --files $staged"
		echo ""
		echo "  (That checks only what you staged. For the whole tree, drop --files entirely --"
		echo "   that is also what CI runs.)"
		echo ""
		exit 1
	fi
else
	echo "  ⚠ citation lint SKIPPED — no python3 on PATH. Documentation citations were NOT checked."
fi

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# Every NEW unencoded open() call in staged Python is refused. See system/tools/encoding_lint.py --
# the AST-based check for the cp1252-on-Windows silent-wrong-bytes defect this closes. It is a
# per-file defect-COUNT ratchet against the HEAD pre-image, so a file that already had unencoded
# calls before this hook existed is not retroactively blocked -- only a RISE in the count is.
#
# WHY --staged, NEVER --scan-file, FROM THIS HOOK: --scan-file is whole-file mode, for manual and
# mutation testing only. Wiring it into a hook would flag every pre-existing call in the tree on
# every commit, not just what this commit adds -- the same "one stale spot blocks every unrelated
# commit" failure citation_lint's own history (issues #81, #90, #74.3) already paid for once. This
# hook must NEVER pass --scan-file to encoding_lint.py.
# EXIT 1 vs EXIT 2 ARE DIFFERENT ANSWERS AND MUST NOT SHARE A BRANCH (ported from ClaudeOps
# 2026-08-23). `if ! ...` refuses on ANY non-zero, which folds "I found a real violation" (1)
# together with "there was no Python staged to look at" (2). "No .py staged" is the ORDINARY case
# for a markdown-only, shell-only or config-only commit -- and treating it as a refusal BRICKS
# every such commit, including `git commit --amend` on a message. Measured cost before this fix:
# a security fix to guard_hook_sop_read.sh could not be committed to this repo at all, and PR
# #104's commit message could not be corrected to name 6 of its 10 files.
# The absent subject is still SPOKEN (exit 2 prints its reason) -- it is just not fatal.
#
# A THIRD STATE, DISTINCT FROM BOTH ABOVE: THE SCRIPT ITSELF IS MISSING (found 2026-08-24). "no
# python3 on PATH" and "no .py staged" are both ordinary, environment- or commit-shaped absences --
# the CONTROL is present and simply has nothing to check, or nothing to check it with. A missing
# encoding_lint.py is not that: the control itself has been removed from this checkout, and python3
# would happily exit 2 ("[Errno 2] No such file or directory") -- indistinguishable, to the case
# above, from "nothing to check." Measured: a fresh clone of origin/main with this hook wired ran
# `python3 <missing path> --staged --quiet`, got exit 2, and committed a bare unencoded open() clean.
# That is fail-open on the control disappearing, not on its input being empty, so it does not get
# the same pass this hook gives an absent python3 or an absent .py file: it REFUSES.
if command -v python3 >/dev/null 2>&1; then
	if [ ! -f "$repo/system/tools/encoding_lint.py" ]; then
		echo "  ⛔ encoding lint tool MISSING — system/tools/encoding_lint.py is not present in this checkout."
		echo "     Commit refused. This is not 'nothing to check' -- the security control itself is absent."
		echo "     Restore it (git checkout origin/main -- system/tools/encoding_lint.py) or pull latest."
		exit 1
	fi
	encoding_out=$(python3 "$repo/system/tools/encoding_lint.py" --staged --quiet 2>&1)
	encoding_status=$?
	if [ "$encoding_status" -eq 1 ]; then
		printf '%s\n' "$encoding_out"
		echo "  Commit refused. Fix the encoding_lint.py findings above, or run it yourself to see them again:"
		echo ""
		echo "      python3 system/tools/encoding_lint.py --staged"
		echo ""
		exit 1
	elif [ "$encoding_status" -eq 2 ]; then
		# encoding_lint.py's CANNOT-EVALUATE (exit 2) covers THREE distinct causes -- see its
		# own --help: no-python-staged (ordinary: nothing for this commit to check), and
		# unparseable <path> / no-git (NOT ordinary: the check itself did not complete). The
		# first is the commit-shaped absence this hook has always waved through. The other two
		# are the control failing to run, same category as the missing-script case above -- and
		# folding them into one warn-and-pass branch was itself a fail-open: an unparseable
		# staged .py file, or a broken git, produced the identical single-line warning as
		# "nothing to check" and the commit went through either way. Split them.
		if printf '%s\n' "$encoding_out" | head -1 | grep -q 'CANNOT-EVALUATE: no-python-staged'; then
			echo "  ⚠ encoding lint: $(printf '%s\n' "$encoding_out" | head -1)"
		else
			printf '%s\n' "$encoding_out"
			echo "  ⛔ COMMIT REFUSED — encoding lint could not evaluate your staged changes (see above)."
			echo "     This is not 'nothing to check' -- the check itself did not complete. Fix the"
			echo "     underlying problem (an unparseable staged file, or git) and commit again."
			exit 1
		fi
	fi
else
	echo "  ⚠ encoding lint SKIPPED — no python3 on PATH. New unencoded open() calls were NOT checked."
fi

exit 0
