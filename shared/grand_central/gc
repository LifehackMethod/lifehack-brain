#!/bin/sh
# gc: shim for gc.py (uses the venv in the product data folder, gc_settings.data_root(), when present)
D="$(cd "$(dirname "$0")" && pwd)"
PY="$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import gc_settings; print(gc_settings.data_root())' "$D")/venv/bin/python"
[ -x "$PY" ] || PY=python3
exec "$PY" "$D/gc.py" "$@"
